# Generate on the droplet only:
# python3 scripts/init-env.py --production --deploy-path /opt/i-have-been
# Runtime credentials stay in /opt/i-have-been/.env; keep this template public.
COMPOSE_PROJECT_NAME=i-have-been
POSTGRES_USER=ihb
POSTGRES_DB=ihb
POSTGRES_PASSWORD=replace-me
GARAGE_RPC_SECRET=replace-me
GARAGE_ADMIN_TOKEN=replace-me
S3_BUCKET=i-have-been-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
ALLOW_REGISTRATION=true
USER_PHOTO_MAX_BYTES=20971520
USER_VIDEO_MAX_BYTES=104857600
APP_MEMORY_LIMIT=768m

# Telemetry is opt-in. Enable the observability profile at the same time.
TELEMETRY_ENABLED=false
COMPOSE_PROFILES=
TELEMETRY_TRACE_SAMPLE_RATIO=0.1
TELEMETRY_METRIC_INTERVAL_MS=60000
# From Grafana Cloud > OpenTelemetry > Configure. Keep credentials private.
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=
