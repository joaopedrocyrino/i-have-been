{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;app;ihb.test",
  "Security": {
    "AllowRegistration": true
  },
  "Storage": {
    "MaxUploadBytes": 104857600,
    "UserPhotoMaxBytes": 20971520,
    "UserVideoMaxBytes": 104857600
  },
  "MalwareScanning": {
    "Host": "clamav",
    "Port": 3310,
    "TimeoutSeconds": 120,
    "MaxDefinitionAgeHours": 72
  },
  "RequestLimits": {
    "IpPerMinute": 600,
    "AccountPerMinute": 300,
    "ConcurrentRequests": 64,
    "SensitivePerMinute": 25,
    "UploadsPerMinute": 12,
    "ConcurrentUploads": 8,
    "ConcurrentUploadsPerAccount": 2
  },
  "Telemetry": {
    "Enabled": false,
    "Endpoint": "http://otel-collector:4318",
    "TraceSampleRatio": 0.1,
    "MetricIntervalMilliseconds": 60000,
    "ExportTimeoutMilliseconds": 3000,
    "ServiceVersion": "local"
  }
}
