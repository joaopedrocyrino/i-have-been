# Run python3 scripts/init-env.py to generate real, independent local secrets.
COMPOSE_PROJECT_NAME=i-have-been
APP_PORT=4188
ASPNETCORE_ENVIRONMENT=Development
ALLOWED_HOSTS=localhost;127.0.0.1;app;ihb.test
POSTGRES_USER=ihb
POSTGRES_DB=ihb
POSTGRES_PASSWORD=replace-me
GARAGE_RPC_SECRET=replace-me
GARAGE_ADMIN_TOKEN=replace-me
S3_BUCKET=i-have-been-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
ALLOW_REGISTRATION=true
USER_PHOTO_MAX_BYTES=20971520
USER_VIDEO_MAX_BYTES=104857600

# Telemetry is opt-in. Enable the observability profile at the same time.
TELEMETRY_ENABLED=false
COMPOSE_PROFILES=
TELEMETRY_TRACE_SAMPLE_RATIO=0.1
TELEMETRY_METRIC_INTERVAL_MS=60000
